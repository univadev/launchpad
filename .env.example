# Copy to .env.local and fill in. Never commit .env.local.

# --- Supabase (browser) ---
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- Clerk (auth) ---
VITE_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# --- Groq (server-side only, powers AI feedback + moderation) ---
# Used by netlify/functions/analyze-project.js and moderate-content.js.
# Without it, AI feedback returns a 503 and moderation quietly allows everything.
# Get a key at https://console.groq.com/keys
# Set it here for local dev, AND in Netlify > Site settings > Environment variables for production.
# No VITE_ prefix on purpose — it must never be exposed to the browser.
GROQ_API_KEY=

# --- Deadline reminder emails (server-side only) ---
# Used by netlify/functions/deadline-reminders.js, which runs daily on Netlify.
# Service role key: Supabase > Project Settings > API. It bypasses RLS, so it
# must NEVER get a VITE_ prefix or be used in browser code.
SUPABASE_SERVICE_ROLE_KEY=
# https://resend.com/api-keys
RESEND_API_KEY=
# Must be on a domain verified in Resend. The default (onboarding@resend.dev)
# can only deliver to the email address that owns the Resend account.
REMINDER_FROM_EMAIL=Launchpad <reminders@yourdomain.com>
